.card.bg-base-100.border.border-base-300.shadow-sm.h-full
  .card-body.gap-3
    .flex.gap-4
      - if media_asset.preview.attached?
        = image_tag url_for(media_asset.preview), class: "w-24 h-24 object-cover rounded-box bg-base-200 shrink-0", alt: ""
      - else
        .w-24.h-24.bg-base-200.rounded-box.flex.items-center.justify-center.text-xs.text-base-content/50.shrink-0
          | …
      .min-w-0.flex-1.space-y-1
        p.font-medium.truncate title=media_asset.file.filename.to_s = media_asset.file.filename
        span.badge.badge-soft class=status_badge_class = media_asset.processing_status.to_s.humanize
        - if media_asset.duration_seconds.present?
          p.text-sm.text-base-content/60 #{media_asset.duration_seconds}s
        - if media_asset.failed? && media_asset.metadata["error"].present?
          p.text-xs.text-error.truncate title=media_asset.metadata["error"] = media_asset.metadata["error"]
