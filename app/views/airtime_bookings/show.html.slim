- content_for :title, t('.title')
- time_zone = Current.user.organization.time_zone

.mx-auto.w-full.max-w-6xl
  = render 'shared/page_header', title: t('.title')

  .card.bg-base-100.border.border-base-300.shadow-sm.mb-4
    .card-body.gap-2
      p
        span.font-medium = @airtime_booking.broadcast_point_group.name
      p.text-sm.text-base-content/60 = t('airtime_bookings.index.status.' + @airtime_booking.status)
      p.text-sm
        = l(@airtime_booking.starts_at.in_time_zone(time_zone), format: :short)
        |  —
        = l(@airtime_booking.ends_at.in_time_zone(time_zone), format: :short)
      p.text-sm = t('airtime_bookings.index.seconds', count: @airtime_booking.seconds)
      - if @airtime_booking.confirmed?
        .card-actions.mt-2
          = link_to t('.reschedule'), reschedule_airtime_booking_path(@airtime_booking), class: 'btn btn-ghost btn-sm'
          = button_to t('.cancel'), cancel_airtime_booking_path(@airtime_booking), method: :delete, class: 'btn btn-ghost btn-sm text-error', form: { data: { turbo_confirm: t('.cancel_confirm') } }

  = render 'occupied_slots', occupied_slots: @occupied_slots, time_zone: time_zone

  = link_to t('.back'), airtime_bookings_path, class: 'link link-hover text-sm'
