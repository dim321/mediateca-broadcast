- content_for :title, t(".title")

.mx-auto.w-full.max-w-6xl
  = render "shared/page_header", title: t(".title")

  = turbo_stream_from Current.organization, :media_library

  .card.bg-base-100.border.border-base-300.shadow-sm.mb-6
    .card-body.gap-4
      h2.card-title.text-base = t(".upload_heading")
      = form_with model: @media_asset, url: media_assets_path, local: true, multipart: true, class: "flex flex-col gap-3" do |f|
        .flex.flex-col.sm:flex-row.sm:flex-wrap.sm:items-center.gap-3 data-controller="file-picker"
          = f.file_field :file, accept: "video/mp4,video/webm,image/*,audio/*,.pdf,.ppt,.pptx", id: "media_asset_file_input", class: "sr-only", data: { file_picker_target: "input", action: "change->file-picker#sync" }
          label.btn.btn-outline.btn-sm.w-fit.cursor-pointer for="media_asset_file_input"
            = t(".choose_file_button")
          span.text-sm.text-base-content/60.truncate.max-w-56.sm:max-w-xs.md:max-w-sm data-file-picker-target="name" title=""
            = t(".no_file_selected")
        = f.submit t(".upload_submit"), class: "btn btn-primary w-fit"

  #media_assets_grid.grid.grid-cols-1.md:grid-cols-2.lg:grid-cols-3.gap-4
    - @media_assets.each do |asset|
      = render "media_assets/media_asset", media_asset: asset
