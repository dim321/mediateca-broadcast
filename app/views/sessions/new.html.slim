- content_for :title, t(".title")

.card.w-full.max-w-md.bg-base-100.shadow-sm.border.border-base-300
  .card-body.gap-4
    h1.card-title.text-2xl = t(".title")
    = form_with url: login_path, method: :post, local: true, class: "flex flex-col gap-4" do
      div
        = label_tag :email, t(".email"), class: "label"
        = email_field_tag :email, params[:email], class: "input input-bordered w-full", required: true, autocomplete: "email"
      div
        = label_tag :password, t(".password"), class: "label"
        = password_field_tag :password, nil, class: "input input-bordered w-full", required: true, autocomplete: "current-password"
      .card-actions.justify-end.mt-2
        = submit_tag t(".submit"), class: "btn btn-primary"
