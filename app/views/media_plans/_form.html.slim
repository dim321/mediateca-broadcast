- time_zone = Current.user.organization.time_zone
= form_with model: media_plan, class: 'space-y-4 max-w-xl' do |f|
  - if media_plan.errors.any?
    ul.text-sm.text-red-700.list-disc.pl-5
      - media_plan.errors.full_messages.each do |message|
        li = message
  div
    = f.label :rotation_id, class: 'block text-sm font-medium'
    = f.collection_select :rotation_id, @rotations, :id, :name, { include_blank: true }, class: 'mt-1 border rounded px-3 py-2 w-full'
  div
    = f.label :broadcast_point_group_id, class: 'block text-sm font-medium'
    = f.collection_select :broadcast_point_group_id, @broadcast_point_groups, :id, :name, { include_blank: true }, class: 'mt-1 border rounded px-3 py-2 w-full'
  div
    = f.label :starts_at, class: 'block text-sm font-medium'
    = f.datetime_field :starts_at, value: schedule_datetime_field_value(media_plan.starts_at, time_zone), class: 'mt-1 border rounded px-3 py-2 w-full'
  div
    = f.label :ends_at, class: 'block text-sm font-medium'
    = f.datetime_field :ends_at, value: schedule_datetime_field_value(media_plan.ends_at, time_zone), class: 'mt-1 border rounded px-3 py-2 w-full'
  .flex.gap-3
    = f.submit class: 'rounded bg-blue-600 text-white px-4 py-2 text-sm'
    = link_to t('.cancel'), media_plans_path, class: 'text-sm text-blue-600 underline py-2'
