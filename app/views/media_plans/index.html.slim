- content_for :title, t('.title')
- actions = capture do
  = link_to t('.new_media_plan'), new_media_plan_path, class: 'btn btn-primary btn-sm'

.mx-auto.w-full.max-w-6xl
  = render 'shared/page_header', title: t('.title'), actions: actions

  - if @media_plans.any?
    .grid.gap-3
      - time_zone = Current.user.organization.time_zone
      - @media_plans.each do |media_plan|
        .card.bg-base-100.border.border-base-300.shadow-sm
          .card-body.gap-2
            = link_to media_plan.rotation.name, media_plan, class: 'link link-hover font-medium'
            p.text-sm.text-base-content/60 = media_plan.broadcast_point_group.name
            p.text-sm.text-base-content/60
              = l(media_plan.starts_at.in_time_zone(time_zone), format: :short)
              |  —
              = l(media_plan.ends_at.in_time_zone(time_zone), format: :short)
            .card-actions.mt-1
              = link_to t('.edit'), edit_media_plan_path(media_plan), class: 'btn btn-ghost btn-sm'
              = button_to t('.delete'), media_plan_path(media_plan), method: :delete, class: 'btn btn-ghost btn-sm text-error', form: { data: { turbo_confirm: t('.delete_confirm') } }
  - else
    .card.bg-base-100.border.border-base-300.shadow-sm
      .card-body
        p.text-base-content/60 = t('.empty')
