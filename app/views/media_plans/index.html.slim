- content_for :title, t('.title')

.flex.flex-col.gap-4.w-full.max-w-6xl
  .flex.items-center.justify-between.gap-4
    h1.text-2xl.font-bold = t('.title')
    = link_to t('.new_media_plan'), new_media_plan_path, class: 'rounded bg-blue-600 text-white px-4 py-2 text-sm'
  - if @media_plans.any?
    ul.list-none.space-y-3
      - time_zone = Current.user.organization.time_zone
      - @media_plans.each do |media_plan|
        li.border.rounded.p-3
          = link_to media_plan.rotation.name, media_plan, class: 'font-medium text-blue-600 underline'
          p.text-sm.text-gray-600 = media_plan.broadcast_point_group.name
          p.text-sm.text-gray-600
            = l(media_plan.starts_at.in_time_zone(time_zone), format: :short)
            |  —
            = l(media_plan.ends_at.in_time_zone(time_zone), format: :short)
          .flex.gap-3.mt-2
            = link_to t('.edit'), edit_media_plan_path(media_plan), class: 'text-blue-600 underline text-sm'
            = button_to t('.delete'), media_plan_path(media_plan), method: :delete, class: 'text-red-600 underline text-sm bg-transparent border-0 p-0 cursor-pointer', form: { data: { turbo_confirm: t('.delete_confirm') } }
  - else
    p.text-gray-600 = t('.empty')
