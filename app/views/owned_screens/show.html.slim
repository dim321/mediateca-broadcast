- content_for :title, @screen.name

.mx-auto.w-full.max-w-6xl.space-y-6
  .flex.flex-col.sm:flex-row.sm:items-center.sm:justify-between.gap-4
    h1.text-2xl.font-semibold.tracking-tight = @screen.name
    .flex.flex-wrap.gap-2
      = link_to t('.edit'), edit_owned_screen_path(@screen), class: 'btn btn-primary btn-sm'
      = button_to t('.delete'), owned_screen_path(@screen), method: :delete, class: 'btn btn-error btn-sm btn-outline', form: { data: { turbo_confirm: t('.delete_confirm') } }
      = link_to t('.back'), owned_screens_path, class: 'btn btn-ghost btn-sm'

  .card.bg-base-100.border.border-base-300.shadow-sm
    .card-body.gap-2
      p
        span.text-base-content/60 = "#{t('.location')}: "
        = @screen.station.location.name
      p
        span.text-base-content/60 = "#{t('.station')}: "
        = @screen.station.name
      p
        span.text-base-content/60 = "#{t('.orientation')}: "
        = t("owned_screens.form.orientation.#{@screen.orientation}")
