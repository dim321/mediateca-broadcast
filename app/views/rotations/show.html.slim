- content_for :title, t(".title", name: @rotation.name)

.flex.flex-col.gap-6.w-full.max-w-6xl
  .flex.flex-wrap.items-baseline.justify-between.gap-4
    h1.text-2xl.font-bold = @rotation.name
    .flex.flex-wrap.gap-3.text-sm
      = link_to t(".edit_rotation"), edit_rotation_path(@rotation), class: "text-blue-600 underline"
      = link_to t(".back"), rotations_path, class: "text-blue-600 underline"
      = link_to t(".media_library"), root_path, class: "text-blue-600 underline"
  .flex.flex-col.lg:flex-row.gap-8
    .flex-1.min-w-0
      h2.text-lg.font-semibold.mb-3 = t(".items_heading")
      - if @items.any?
        div[
          data-controller="rotation-sort"
          data-rotation-sort-url-value=internal_rotation_reorder_path(rotation_id: @rotation.id)
        ]
          ul.list-none.p-0.m-0[data-rotation-sort-target="list"]
            - @items.each do |item|
              = render Rotations::RotationItemComponent.new(rotation: @rotation, item: item)
      - else
        p.text-gray-600 = t(".no_items")
    .w-full.lg:w-80.shrink-0
      h2.text-lg.font-semibold.mb-3 = t(".add_heading")
      - if @available_media.any?
        = form_with model: [@rotation, @rotation_item], url: rotation_rotation_items_path(@rotation), class: "flex flex-col gap-2" do |f|
          = f.collection_select :media_asset_id, @available_media, :id,
            method(:media_asset_select_label),
            { prompt: t(".select_media") }, class: "select select-bordered w-full"
          = f.submit t(".add_item"), class: "rounded bg-blue-600 text-white px-4 py-2 text-sm w-fit cursor-pointer"
      - else
        p.text-gray-600.text-sm = t(".no_media_available")
