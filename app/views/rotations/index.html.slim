- content_for :title, t(".title")
- actions = capture do
  = link_to t(".new_rotation"), new_rotation_path, class: "btn btn-primary btn-sm"

.mx-auto.w-full.max-w-6xl
  = render "shared/page_header", title: t(".title"), actions: actions

  - if @rotations.any?
    ul.list.bg-base-100.border.border-base-300.rounded-box.shadow-sm
      - @rotations.each do |pl|
        li.list-row
          = link_to pl.name, pl, class: "link link-hover text-base font-medium"
  - else
    .card.bg-base-100.border.border-base-300.shadow-sm
      .card-body
        p.text-base-content/60 = t(".empty")
