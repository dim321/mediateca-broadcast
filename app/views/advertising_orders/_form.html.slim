- time_zone = local_assigns.fetch(:time_zone) { Current.user.organization.time_zone }
- cancel_url = local_assigns.fetch(:cancel_url, advertising_orders_path)
- sphere_text = advertising_order.business_sphere.presence || local_assigns[:business_sphere_preview]
- show_picker = local_assigns.fetch(:show_screen_picker, false)
- stimulus_controllers = ['order-grid', 'order-windows']
- stimulus_controllers << 'order-screen-picker' if show_picker
= form_with model: advertising_order, url: local_assigns[:form_url], class: 'space-y-6', data: { controller: stimulus_controllers.join(' '), action: 'order-grid:recompute->order-grid#recompute' } do |f|
  = hidden_field_tag :grid_from, @grid_dates.first
  = hidden_field_tag :grid_to, @grid_dates.last
  - if local_assigns[:organization_id].present?
    = hidden_field_tag 'advertising_order[organization_id]', organization_id
  - if advertising_order.errors.any?
    ul.text-sm.text-error.list-disc.pl-5
      - advertising_order.errors.full_messages.each do |message|
        li = message
  - advertising_order.advertising_order_lines.each do |line|
    - line.errors.full_messages.each do |message|
      p.text-sm.text-error = message
    - line.advertising_order_line_days.each do |day|
      - day.errors.full_messages.each do |message|
        p.text-sm.text-error = message
  - if sphere_text.present?
    p.text-sm.text-base-content/60
      = AdvertisingOrder.human_attribute_name(:business_sphere)
      | :
      =< sphere_text
  div.grid.gap-4.md:grid-cols-2
    div
      = f.label :product_name, class: 'block text-sm font-medium'
      = f.text_field :product_name, class: 'input input-bordered w-full mt-1'
    - if advertising_order.new_record?
      div
        = f.label :media_asset_id, class: 'block text-sm font-medium'
        = f.select :media_asset_id,
            options_for_select(@media_assets.map { |asset| [asset.file.attached? ? asset.file.filename.to_s : asset.id.to_s, asset.id] }, advertising_order.media_asset_id),
            { include_blank: true },
            class: 'select select-bordered w-full mt-1',
            id: 'advertising_order_media_asset_id'
    div
      = f.label :placement_kind, class: 'block text-sm font-medium'
      = f.select :placement_kind, AdvertisingOrder.placement_kinds.keys.map { |kind| [t("enums.advertising_order.placement_kind.#{kind}"), kind] }, {}, class: 'select select-bordered w-full mt-1'
    div
      = f.label :shows_per_hour, t('.shows_per_hour'), class: 'block text-sm font-medium'
      = f.number_field :shows_per_hour, min: 1, class: 'input input-bordered w-full mt-1', data: { order_grid_target: 'showsPerHour', action: 'input->order-grid#recompute' }
  .card.bg-base-100.border.border-base-300
    .card-body.gap-3
      h2.card-title.text-base = t('.windows')
      .space-y-3 data-order-windows-target='list'
        - windows = advertising_order.advertising_order_windows
        - windows = [AdvertisingOrderWindow.new(starts_at: '09:00', ends_at: '12:00')] if windows.empty?
        - windows.each do |window|
          = render 'advertising_orders/window_fields', starts_at: order_clock_hhmm(window.starts_at), ends_at: order_clock_hhmm(window.ends_at)
      button.btn.btn-sm.btn-ghost type='button' data-action='order-windows#add' = t('.add_window')
      template data-order-windows-target='template'
        = render 'advertising_orders/window_fields', starts_at: '09:00', ends_at: '12:00'
  = render 'media_plans/occupied_slots', occupied_slots: @occupied_slots || [], time_zone: time_zone
  - if show_picker
    = render 'advertising_orders/screen_picker'
  .card.bg-base-100.border.border-base-300
    .card-body.gap-3
      h2.card-title.text-base = t('.grid')
      .space-y-4 data-order-grid-target='lines' data-order-screen-picker-target='gridLines'
        - advertising_order.advertising_order_lines.select(&:screen_id).each_with_index do |line, index|
          = render 'advertising_orders/line_fields', **order_line_field_locals(line, index)
      template data-order-screen-picker-target='rowTemplate'
        = render 'advertising_orders/line_fields', **order_line_field_locals(AdvertisingOrderLine.new, 'NEW_LINE')
  .flex.gap-3
    = f.submit t('.submit'), class: 'btn btn-primary btn-sm'
    = link_to t('.cancel'), cancel_url, class: 'btn btn-ghost btn-sm'
