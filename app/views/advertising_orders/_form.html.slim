- time_zone = local_assigns.fetch(:time_zone) { Current.user.organization.time_zone }
- cancel_url = local_assigns.fetch(:cancel_url, advertising_orders_path)
- sphere_text = advertising_order.business_sphere.presence || local_assigns[:business_sphere_preview]
- show_picker = local_assigns.fetch(:show_screen_picker, false)
- stimulus_controllers = ['order-grid', 'order-windows']
- stimulus_controllers << 'order-screen-picker' if show_picker
- form_data = { controller: stimulus_controllers.join(' '), action: 'order-grid:recompute->order-grid#recompute order-screen-picker:recompute->order-windows#updateAutomaticWindow' }
= form_with model: advertising_order, url: local_assigns[:form_url], class: 'space-y-6', data: form_data do |f|
  = hidden_field_tag :grid_from, @grid_dates.first
  = hidden_field_tag :grid_to, @grid_dates.last
  - if local_assigns[:organization_id].present?
    = hidden_field_tag 'advertising_order[organization_id]', organization_id
  - if advertising_order.errors.any?
    ul.text-sm.text-error.list-disc.pl-5
      - advertising_order.errors.full_messages.each do |message|
        li = message
  - advertising_order.advertising_order_lines.each do |line|
    - line.errors.full_messages.each do |message|
      p.text-sm.text-error = message
    - line.advertising_order_line_days.each do |day|
      - day.errors.full_messages.each do |message|
        p.text-sm.text-error = message
  - if sphere_text.present?
    p.text-sm.text-base-content/60
      = AdvertisingOrder.human_attribute_name(:business_sphere)
      | :
      =< sphere_text
  div.grid.gap-4.md:grid-cols-2
    div
      = f.label :product_name, class: 'block text-sm font-medium'
      = f.text_field :product_name, class: 'input input-bordered w-full mt-1'
    div
      = f.label :placement_kind, class: 'block text-sm font-medium'
      = f.select :placement_kind, AdvertisingOrder.placement_kinds.keys.map { |kind| [t("enums.advertising_order.placement_kind.#{kind}"), kind] }, {}, class: 'select select-bordered w-full mt-1'
    - if advertising_order.new_record? || advertising_order.draft? || advertising_order.active?
      div.md:col-span-2
        = render 'advertising_orders/clips_editor',
            selected_assets: order_form_selected_media_assets(advertising_order),
            available_assets: order_form_available_media_assets(advertising_order, @media_assets)
  - if show_picker
    = render 'advertising_orders/screen_picker'
  - frequency_options = order_shows_per_hour_select_options(advertising_order)
  div
    = f.label :shows_per_hour, t('.shows_per_hour'), class: 'block text-sm font-medium'
    = f.select :shows_per_hour,
        options_for_select(frequency_options, advertising_order.shows_per_hour),
        { include_blank: true },
        class: 'select select-bordered w-full mt-1',
        id: 'advertising_order_shows_per_hour',
        disabled: frequency_options.empty?,
        data: { order_grid_target: 'showsPerHour', order_screen_picker_target: 'showsPerHour', action: 'change->order-grid#recompute' }
    p.text-sm.text-base-content/60.mt-1 = t('.shows_per_hour_from_screens')
  .card.bg-base-100.border.border-base-300
    .card-body.gap-3
      h2.card-title.text-base = t('.windows')
      .space-y-3 data-order-windows-target='list'
        - windows = advertising_order.advertising_order_windows
        - windows = [AdvertisingOrderWindow.new(starts_at: '08:00', ends_at: '23:00')] if windows.empty?
        - windows.each do |window|
          = render 'advertising_orders/window_fields',
              starts_at: order_clock_hhmm(window.starts_at),
              ends_at: order_clock_hhmm(window.ends_at),
              automatic: advertising_order.new_record? && windows.one?
      button.btn.btn-sm.btn-ghost type='button' data-action='order-windows#add' = t('.add_window')
      template data-order-windows-target='template'
        = render 'advertising_orders/window_fields', starts_at: '09:00', ends_at: '12:00', automatic: false
  .card.bg-base-100.border.border-base-300
    .card-body.gap-3
      h2.card-title.text-base = t('.distribution_strategy')
      .grid.gap-2.sm:grid-cols-2.lg:grid-cols-3
        - AdvertisingOrder.distribution_strategies.each_key do |strategy|
          label.flex.items-center.gap-2.cursor-pointer
            = f.radio_button :distribution_strategy, strategy,
                class: 'radio radio-sm',
                data: { order_grid_target: 'distributionStrategy', action: 'change->order-grid#recompute' }
            span = t(".distribution_strategies.#{strategy}")
  = render 'media_plans/occupied_slots', occupied_slots: @occupied_slots || [], time_zone: time_zone
  .card.bg-base-100.border.border-base-300
    .card-body.gap-3
      h2.card-title.text-base = t('.grid')
      .flex.flex-wrap.gap-4.text-xs.text-base-content/70
        span.inline-flex.items-center.gap-2
          span.h-3.w-3.rounded-sm.bg-success/30.border.border-success/40
          = t('.grid_legend.with_shows')
        span.inline-flex.items-center.gap-2
          span.h-3.w-3.rounded-sm.bg-base-200.border.border-base-300
          = t('.grid_legend.without_shows')
      - grid_months = advertising_grid_months(@grid_dates)
      - grid_rows = advertising_order.advertising_order_lines.select(&:screen_id)
      - grid_months.each_with_index do |(month, dates), index|
        .overflow-x-auto.rounded-box.border.border-base-300.shadow-sm.mb-4
          = render 'advertising_orders/monthly_grid',
              month: month,
              dates: dates,
              rows: grid_rows,
              advertising_order: advertising_order,
              grid_id: index.zero? ? 'order-airtime-grid' : "order-airtime-grid-#{month.strftime('%Y-%m')}",
              show_grand_total: index == grid_months.size - 1
  .flex.gap-3
    = f.submit t('.submit'), class: 'btn btn-primary btn-sm'
    = link_to t('.cancel'), cancel_url, class: 'btn btn-ghost btn-sm'
