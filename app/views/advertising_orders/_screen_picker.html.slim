- return unless @order_screens
.card.bg-base-100.border.border-base-300
  .card-body.gap-3
    .flex.flex-wrap.items-baseline.justify-between.gap-2
      h2.card-title.text-base = t('advertising_orders.form.screens')
      p.text-sm.text-base-content/60
        = t('advertising_orders.form.screen_picker.selected')
        | 
        span data-order-screen-picker-target='count' 0
    p.text-sm.text-base-content/60 = t('advertising_orders.form.screen_picker.hint')
    - if @order_screens.empty?
      p.text-sm.text-base-content/60 = t('advertising_orders.form.screen_picker.empty')
    - else
      .overflow-x-auto
        table.table.table-sm
          thead
            tr
              th
                input.checkbox.checkbox-sm type='checkbox' aria-label=t('advertising_orders.form.screen_picker.select_all') data-order-screen-picker-target='selectAll' data-action='order-screen-picker#toggleAll'
              th = Screen.human_attribute_name(:name)
              th = Location.model_name.human
              th = Station.model_name.human
              th = Tag.model_name.human(count: 2)
              th = BroadcastPortrait.model_name.human
              th = t('advertising_orders.form.screen_picker.hours')
            tr
              th
              th
              th
                input.input.input-xs.input-bordered.w-full type='search' placeholder=t('advertising_orders.form.screen_picker.filter_location') data-order-screen-picker-target='filter' data-filter-key='location' data-action='input->order-screen-picker#filterRows'
              th
                input.input.input-xs.input-bordered.w-full type='search' placeholder=t('advertising_orders.form.screen_picker.filter_station') data-order-screen-picker-target='filter' data-filter-key='station' data-action='input->order-screen-picker#filterRows'
              th
                input.input.input-xs.input-bordered.w-full type='search' placeholder=t('advertising_orders.form.screen_picker.filter_tags') data-order-screen-picker-target='filter' data-filter-key='tags' data-action='input->order-screen-picker#filterRows'
              th
                input.input.input-xs.input-bordered.w-full type='search' placeholder=t('advertising_orders.form.screen_picker.filter_portrait') data-order-screen-picker-target='filter' data-filter-key='portrait' data-action='input->order-screen-picker#filterRows'
              th
                input.input.input-xs.input-bordered.w-full type='search' placeholder=t('advertising_orders.form.screen_picker.filter_hours') data-order-screen-picker-target='filter' data-filter-key='hoursLabel' data-action='input->order-screen-picker#filterRows'
          tbody
            - @order_screens.each do |screen|
              - hours_label = order_screen_hours_label(screen)
              tr data-order-screen-picker-target='row' data-screen-id=screen.id data-screen-name=screen.name data-screen-meta="#{[screen.location&.name, screen.station&.name].compact.join(' · ')}" data-hours=(order_screen_hours_json(screen).to_json) data-location=screen.location&.name data-station=screen.station&.name data-tags=screen.tags.map(&:name).join(' ') data-portrait=screen.broadcast_portrait&.name data-hours-label=hours_label
                td
                  = check_box_tag 'advertising_order[screen_ids][]',
                      screen.id,
                      order_screen_selected?(screen),
                      id: "order_screen_#{screen.id}",
                      class: 'checkbox checkbox-sm',
                      data: { action: 'order-screen-picker#selectionChanged' }
                td.font-medium = screen.name
                td = screen.location&.name
                td = screen.station&.name
                td = screen.tags.map(&:name).presence&.join(', ')
                td = screen.broadcast_portrait&.name
                td.whitespace-nowrap = hours_label
