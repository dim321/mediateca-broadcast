- asset = local_assigns[:asset]
- label = asset ? advertising_clip_option_label(asset) : ""
.flex.flex-wrap.items-center.gap-2.rounded-box.border.border-base-300.bg-base-100.p-2 data-order-media-assets-target='row' data-label=label
  = hidden_field_tag 'advertising_order[media_asset_ids][]', asset&.id, id: nil, data: { order_media_assets_target: 'input' }
  span.flex-1.text-sm data-order-media-assets-target='label' = label
  .join.join-horizontal
    button.btn.btn-ghost.btn-xs.join-item type='button' data-action='order-media-assets#moveUp' aria-label=t('advertising_orders.form.move_up') ↑
    button.btn.btn-ghost.btn-xs.join-item type='button' data-action='order-media-assets#moveDown' aria-label=t('advertising_orders.form.move_down') ↓
    button.btn.btn-ghost.btn-xs.join-item type='button' data-action='order-media-assets#remove' data-order-media-assets-target='removeButton' = t('advertising_orders.form.remove_clip')
