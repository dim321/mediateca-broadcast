- content_for :title, @advertising_order.product_name
- coverage = @coverage
- can_mutate = policy(@advertising_order)
- none = t('advertising_orders.show.none')

.flex.flex-col.gap-4.w-full.max-w-6xl
  = render 'shared/page_header', title: @advertising_order.product_name

  - if @advertising_order.rejected?
    .alert.alert-error role="alert"
      span = t('.rejected', reason: t("enums.advertising_order.rejection_reason.#{@advertising_order.rejection_reason}"))

  .flex.gap-3.flex-wrap
    - if @advertising_order.rejected? && can_mutate.update?
      = link_to t('.edit_rejected'), edit_advertising_order_path(@advertising_order), class: 'btn btn-primary btn-sm'
    - elsif can_mutate.update? || can_mutate.revise?
      = link_to t('.edit'), edit_advertising_order_path(@advertising_order), class: 'btn btn-ghost btn-sm'
    - if can_mutate.activate? && @advertising_order.draft?
      = button_to t('.activate'), activate_advertising_order_path(@advertising_order), method: :post, class: 'btn btn-primary btn-sm'
    - elsif creator_manager_awaits_activation?
      = button_to t('.activate'), activate_advertising_order_path(@advertising_order), method: :post, class: 'btn btn-primary btn-sm', disabled: true
    - if can_mutate.activate? && @advertising_order.active? && coverage.unoccupied_days.any?
      = button_to t('.occupy_again'), activate_advertising_order_path(@advertising_order), method: :post, class: 'btn btn-primary btn-sm'
    - if can_mutate.replace_clip?
      = link_to t('.replace_clip'), replace_clip_advertising_order_path(@advertising_order), class: 'btn btn-ghost btn-sm'
    - if can_mutate.print?
      = link_to t('.print'), print_advertising_order_path(@advertising_order), class: 'btn btn-ghost btn-sm'
    - if can_mutate.cancel? && @advertising_order.active?
      = button_to t('.cancel_order'), cancel_advertising_order_path(@advertising_order), method: :post, class: 'btn btn-ghost btn-sm text-error', form: { data: { turbo_confirm: t('.cancel_confirm') } }
    - if can_mutate.destroy?
      = button_to t('.destroy'), advertising_order_path(@advertising_order), method: :delete, class: 'btn btn-ghost btn-sm text-error', form: { data: { turbo_confirm: t('.destroy_confirm') } }
    = link_to t('.back'), advertising_orders_path, class: 'btn btn-ghost btn-sm'

  #advertising-order-details.card.bg-base-100.border.border-base-300.shadow-sm
    .card-body.gap-4
      h2.card-title.text-base = t('.details')
      dl.space-y-4
        .grid.gap-4.md:grid-cols-2
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.organization')
            dd.mt-1.text-sm = @advertising_order.organization.name
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.author')
            dd.mt-1.text-sm = @advertising_order.created_by&.display_name || none
        .grid.gap-4.md:grid-cols-2
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.product_name')
            dd.mt-1.text-sm = @advertising_order.product_name
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.business_sphere')
            dd.mt-1.text-sm = @advertising_order.business_sphere.presence || none
        .grid.gap-4.md:grid-cols-2
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.placement_kind')
            dd.mt-1.text-sm = t("enums.advertising_order.placement_kind.#{@advertising_order.placement_kind}")
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.status')
            dd#advertising-order-status.mt-1.flex.flex-wrap.items-center.gap-2
              span.badge.badge-soft = t("enums.advertising_order.status.#{@advertising_order.status}")
              - if @advertising_order.rejected?
                span.text-sm.text-error = t("enums.advertising_order.rejection_reason.#{@advertising_order.rejection_reason}")
        div
          dt.text-sm.font-medium.text-base-content/60 = t('.screens_count')
          dd.mt-1.text-sm = @advertising_order.advertising_order_lines.size
        .grid.gap-4.md:grid-cols-3
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.date_ranges')
            dd.mt-1.text-sm = advertising_order_date_ranges(@advertising_order)
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.day_count')
            dd.mt-1.text-sm = advertising_order_day_count(@advertising_order)
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.total_shows_label')
            dd.mt-1.text-sm = @advertising_order.total_shows
        .grid.gap-4.md:grid-cols-3
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.windows')
            dd.mt-1.text-sm = advertising_order_windows_label(@advertising_order)
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.shows_per_hour')
            dd.mt-1.text-sm = @advertising_order.shows_per_hour || none
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.daily_shows')
            dd.mt-1.text-sm = advertising_order_daily_shows_label(@advertising_order)
        .grid.gap-4.md:grid-cols-2
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.total_sum')
            dd.mt-1.text-sm = money_display(@advertising_order.total_sum_cents)
          div
            dt.text-sm.font-medium.text-base-content/60 = t('.document_version_label')
            dd.mt-1.text-sm = t('.document_version', version: @advertising_order.document_version)
        div
          dt.text-sm.font-medium.text-base-content/60 = t('.clips')
          dd.mt-1.text-sm
            - rows = order_clip_rows(@advertising_order)
            - if rows.empty?
              = none
            - else
              .overflow-x-auto
                table.table.table-sm
                  thead
                    tr
                      th = t('.media_filename')
                      th = t('.media_duration')
                      th = t('.content_type')
                      th = t('.content_kind')
                      th = t('.content_validation')
                  tbody
                    - rows.each do |row|
                      tr
                        td
                          - if row.media_asset
                            = link_to row.title, media_asset_path(row.media_asset), class: 'link link-hover'
                          - else
                            = row.title
                        td = row.duration_seconds || none
                        td
                          - if row.media_asset
                            = t("enums.media_asset.content_type.#{row.media_asset.content_type}")
                          - else
                            = none
                        td
                          - if row.media_asset
                            = t("enums.media_asset.content_kind.#{row.media_asset.content_kind}")
                          - else
                            = none
                        td
                          - if row.media_asset
                            = media_asset_validation_label(row.media_asset)
                          - else
                            = none
