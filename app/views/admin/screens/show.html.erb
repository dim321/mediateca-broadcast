<% content_for :title, @screen.name %>
<div class="mb-4">
  <h1 class="text-2xl font-semibold text-gray-900"><%= @screen.name %></h1>
</div>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Screen.human_attribute_name(:name) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @screen.name %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Screen.human_attribute_name(:station) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@screen.station) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Screen.human_attribute_name(:orientation) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@screen, :orientation) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Screen.human_attribute_name(:owner_organization) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@screen.owner_organization) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Tag.model_name.human(count: 2) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @screen.tags.map(&:name).presence&.join(", ") || t("admin.crud.none") %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= BroadcastPortrait.model_name.human %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@screen.broadcast_portrait) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= ServiceTheme.model_name.human %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@screen.broadcast_portrait&.service_theme) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Screen.human_attribute_name(:inherit_operating_hours_from_location) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_boolean(@screen.inherit_operating_hours_from_location) %></dd>
    </div>
  </dl>
</div>
<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <h2 class="mb-4 text-lg font-medium text-gray-900"><%= t("admin.agent_commands.title") %></h2>
  <%= form_with url: admin_screen_agent_commands_path(@screen), scope: :agent_command, class: "space-y-4" do |f| %>
    <div>
      <%= f.label :command_type, t("admin.agent_commands.type"), class: admin_label_class %>
      <%= f.select :command_type, AgentCommand::TYPES, {}, class: admin_select_class %>
    </div>
    <div>
      <%= f.label :url, t("admin.agent_commands.url"), class: admin_label_class %>
      <%= f.text_field :url, class: admin_input_class %>
    </div>
    <div>
      <%= f.label :buffer_ms, t("admin.agent_commands.buffer_ms"), class: admin_label_class %>
      <%= f.number_field :buffer_ms, class: admin_input_class, min: 0 %>
    </div>
    <div>
      <%= f.label :seconds, t("admin.agent_commands.seconds"), class: admin_label_class %>
      <%= f.number_field :seconds, class: admin_input_class, min: 1, max: 120 %>
    </div>
    <%= f.submit t("admin.agent_commands.submit"), class: admin_primary_button_class %>
  <% end %>
  <p class="mt-4 text-sm text-gray-500"><%= t("admin.agent_commands.upload_link_expiry") %></p>

  <% if @agent_commands.any? %>
    <ul class="mt-6 space-y-2 text-sm text-gray-900">
      <% @agent_commands.each do |command| %>
        <li>
          <span class="font-mono"><%= command.public_id %></span>
          <%= command.command_type %>
          <%= command.status %>
          <%= command.result_error %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-6 text-sm text-gray-500"><%= t("admin.agent_commands.empty") %></p>
  <% end %>
</div>
<div class="mt-6 flex flex-wrap gap-3">
  <%= link_to t("admin.chrome.edit"), edit_admin_screen_path(@screen), class: admin_primary_button_class %>
  <% if @screen.broadcast_portrait %>
    <%= link_to t("admin.screens.edit_portrait"), edit_admin_broadcast_portrait_path(@screen.broadcast_portrait), class: admin_secondary_button_class %>
  <% end %>
  <%= link_to t("admin.chrome.back"), admin_screens_path, class: admin_secondary_button_class %>
  <%= button_to t("admin.chrome.destroy"), admin_screen_path(@screen),
        method: :delete,
        data: { turbo_confirm: t("admin.crud.destroy_confirm") },
        class: admin_danger_button_class %>
</div>
