<% content_for :head do %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<% end %>
<% content_for :title, t("admin.advertising_orders.edit_title") %>

<div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t("admin.advertising_orders.edit_title") %></h1>
  <%= link_to @advertising_order.product_name, admin_advertising_order_path(@advertising_order), class: admin_secondary_button_class %>
</div>

<% if @advertising_order.rejected? %>
  <div role="alert" class="<%= admin_flash_class(:alert) %>">
    <%= t("advertising_orders.show.rejected", reason: t("enums.advertising_order.rejection_reason.#{@advertising_order.rejection_reason}")) %>
  </div>
<% end %>

<% grid_end = @advertising_order.advertising_order_line_days.map(&:date).compact.max %>
<%= form_with url: edit_admin_advertising_order_path(@advertising_order), method: :get, html: { class: "flex flex-wrap items-end gap-3 mb-6" } do %>
  <div>
    <label class="<%= admin_label_class %>"><%= t("advertising_orders.form.fill_from") %></label>
    <%= order_grid_date_field_tag :grid_from, @grid_dates.first, html_class: admin_input_class, readonly: @advertising_order.active? %>
  </div>
  <div>
    <label class="<%= admin_label_class %>"><%= t("advertising_orders.form.fill_to") %></label>
    <%= order_grid_date_field_tag :grid_to, @grid_dates.last, html_class: admin_input_class, max: (@advertising_order.active? ? grid_end : nil) %>
  </div>
  <%= submit_tag t("advertising_orders.form.show_grid"), class: admin_primary_button_class %>
<% end %>

<%= render "advertising_orders/form",
      advertising_order: @advertising_order,
      form_url: admin_advertising_order_path(@advertising_order),
      cancel_url: admin_advertising_order_path(@advertising_order),
      time_zone: @form_organization.time_zone,
      show_screen_picker: true,
      submit_label: (@advertising_order.rejected? ? t("advertising_orders.form.resubmit") : nil) %>
