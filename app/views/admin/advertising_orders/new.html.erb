<% content_for :head do %>
  <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
<% end %>
<% content_for :title, t("admin.advertising_orders.new_title") %>

<div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t("admin.advertising_orders.new_title") %></h1>
  <%= link_to t("admin.chrome.back"), admin_advertising_orders_path, class: admin_secondary_button_class %>
</div>

<%= form_with url: new_admin_advertising_order_path, method: :get, html: { class: "flex flex-wrap items-end gap-3 mb-6" } do %>
  <div>
    <label class="<%= admin_label_class %>" for="organization_id"><%= t("admin.advertising_orders.organization") %></label>
    <%= select_tag :organization_id,
          options_from_collection_for_select(@organizations, :id, :name, @form_organization&.id),
          class: admin_select_class,
          onchange: "this.form.submit()" %>
  </div>
  <div>
    <label class="<%= admin_label_class %>"><%= t("advertising_orders.form.fill_from") %></label>
    <%= date_field_tag :grid_from, @grid_dates.first, class: admin_input_class %>
  </div>
  <div>
    <label class="<%= admin_label_class %>"><%= t("advertising_orders.form.fill_to") %></label>
    <%= date_field_tag :grid_to, @grid_dates.last, class: admin_input_class %>
  </div>
  <%= submit_tag t("advertising_orders.form.show_grid"), class: admin_primary_button_class %>
<% end %>

<% if @form_organization %>
  <%= render "advertising_orders/form",
        advertising_order: @advertising_order,
        form_url: admin_advertising_orders_path,
        cancel_url: admin_advertising_orders_path,
        time_zone: @form_organization.time_zone,
        organization_id: @form_organization.id,
        business_sphere_preview: @form_organization.profile&.business_sphere&.name %>
<% end %>
