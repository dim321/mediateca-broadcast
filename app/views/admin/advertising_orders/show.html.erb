<% content_for :title, @advertising_order.product_name %>
<div class="mb-4">
  <h1 class="text-2xl font-semibold text-gray-900"><%= @advertising_order.product_name %></h1>
</div>
<div class="mb-4 flex flex-wrap gap-3">
  <% if @advertising_order.draft? %>
    <%= link_to t("admin.advertising_orders.edit"),
          edit_admin_advertising_order_path(@advertising_order),
          class: admin_primary_button_class %>
    <%= button_to t("admin.advertising_orders.activate"),
          activate_admin_advertising_order_path(@advertising_order),
          method: :post,
          class: admin_primary_button_class %>
  <% end %>
  <% unless @advertising_order.cancelled? || @advertising_order.completed? %>
    <%= link_to t("admin.advertising_orders.cancel"),
          cancel_admin_advertising_order_path(@advertising_order),
          data: { turbo_method: :post, turbo_confirm: t("admin.advertising_orders.cancel_confirm") },
          class: admin_danger_button_class %>
  <% end %>
</div>
<div id="advertising-order-details" class="mt-6 bg-white border border-gray-200 rounded-lg p-6 max-w-5xl">
  <h2 class="mb-4 text-lg font-semibold text-gray-900"><%= t("admin.advertising_orders.show.details") %></h2>
  <dl class="space-y-4">
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.organization") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@advertising_order.organization) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.author") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@advertising_order.created_by) %></dd>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.product_name") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @advertising_order.product_name %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.business_sphere") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @advertising_order.business_sphere.presence || t("admin.crud.none") %></dd>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.placement_kind") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@advertising_order, :placement_kind) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.status") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@advertising_order, :status) %></dd>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.date_ranges") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= advertising_order_date_ranges(@advertising_order) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.day_count") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= advertising_order_day_count(@advertising_order) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.total_shows") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @advertising_order.total_shows %></dd>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-3">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.windows") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= advertising_order_windows_label(@advertising_order) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.shows_per_hour") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @advertising_order.shows_per_hour || t("admin.crud.none") %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.daily_shows") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= advertising_order_daily_shows_label(@advertising_order) %></dd>
      </div>
    </div>
    <div class="grid gap-4 md:grid-cols-4">
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.media_filename") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_attachment_name(@advertising_order.media_asset.file) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.media_duration") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= @advertising_order.media_asset.duration_seconds || t("admin.crud.none") %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.content_type") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@advertising_order.media_asset, :content_type) %></dd>
      </div>
      <div>
        <dt class="text-sm font-medium text-gray-500"><%= t("admin.advertising_orders.show.content_kind") %></dt>
        <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@advertising_order.media_asset, :content_kind) %></dd>
      </div>
    </div>
  </dl>
</div>
<div class="mt-6">
  <%= link_to t("admin.chrome.back"), admin_advertising_orders_path, class: admin_secondary_button_class %>
</div>
