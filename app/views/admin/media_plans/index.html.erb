<% content_for :title, t("admin.nav.media_plans") %>
<div class="mb-4">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t("admin.nav.media_plans") %></h1>
</div>
<%= search_form_for @q, url: admin_media_plans_path, html: { method: :get, class: "mb-4" } do |f| %>
  <% if params[:q].is_a?(ActionController::Parameters) %>
    <% Array(params.dig(:q, :s)).each do |sort| %><%= hidden_field_tag "q[s]", sort %><% end %>
  <% end %>
  <div class="relative max-w-sm">
    <%= f.search_field :status_eq, class: admin_input_class, placeholder: t("admin.crud.search") %>
  </div>
  <div class="mt-2 flex gap-2">
    <%= f.submit t("admin.crud.search_submit"), class: admin_primary_button_class %>
    <% if params[:q].is_a?(ActionController::Parameters) && params.dig(:q, :status_eq).present? %>
      <%= link_to t("admin.crud.clear_search"), admin_media_plans_path, class: admin_secondary_button_class %>
    <% end %>
  </div>
<% end %>
<% if @media_plans.empty? && params[:q].blank? %>
  <%= render "admin/shared/empty_state", title: t("admin.crud.empty.title"), description: t("admin.crud.empty.description") %>
<% elsif @media_plans.empty? %>
  <%= render "admin/shared/empty_state", title: t("admin.crud.empty.search_title"), description: t("admin.crud.empty.search_description"), action_path: admin_media_plans_path, action_label: t("admin.crud.clear_search") %>
<% else %>
  <div class="relative overflow-x-auto shadow-md sm:rounded-lg bg-white">
    <table class="w-full text-sm text-left text-gray-500">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3"><%= sort_link @q, :id %></th>
          <th scope="col" class="px-6 py-3"><%= Organization.model_name.human %></th>
          <th scope="col" class="px-6 py-3"><%= BroadcastPointGroup.model_name.human %></th>
          <th scope="col" class="px-6 py-3"><%= sort_link @q, :status %></th>
          <th scope="col" class="px-6 py-3"><%= sort_link @q, :starts_at %></th>
          <th scope="col" class="px-6 py-3"><span class="sr-only"><%= t("admin.chrome.actions") %></span></th>
        </tr>
      </thead>
      <tbody>
        <% @media_plans.each do |plan| %>
          <tr class="bg-white border-b hover:bg-gray-50">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
              <%= link_to "##{plan.id}", admin_media_plan_path(plan), class: "text-blue-700 hover:underline" %>
            </th>
            <td class="px-6 py-4"><%= admin_link_to_record(plan.organization) %></td>
            <td class="px-6 py-4"><%= admin_link_to_record(plan.broadcast_point_group) %></td>
            <td class="px-6 py-4"><%= admin_enum_label(plan, :status) %></td>
            <td class="px-6 py-4"><%= l(plan.starts_at, format: :short) %></td>
            <td class="px-6 py-4 text-right whitespace-nowrap">
              <%= link_to t("admin.chrome.show"), admin_media_plan_path(plan), class: "font-medium text-blue-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0 p-4">
      <span class="text-sm text-gray-500"><%= t("admin.chrome.page_entries", count: @media_plans.total_count) %></span>
      <%= paginate @media_plans, theme: "admin" %>
    </div>
  </div>
<% end %>
