<% content_for(:title) { t("admin.media_plans.reschedule_title", id: @media_plan.id) } %>

<header class="main-content__header">
  <h1 class="main-content__page-title">
    <%= content_for(:title) %>
  </h1>
</header>

<section class="main-content__body">
  <% if flash[:alert].present? %>
    <p class="flash-alert"><%= flash[:alert] %></p>
  <% end %>

  <%= form_with url: reschedule_admin_media_plan_path(@media_plan), method: :patch do %>
    <div class="field-unit">
      <%= label_tag :broadcast_point_group_id, t("admin.media_plans.broadcast_point_group") %>
      <%= select_tag :broadcast_point_group_id,
            options_from_collection_for_select(
              @broadcast_point_groups,
              :id,
              :name,
              @media_plan.broadcast_point_group_id
            ),
            include_blank: true %>
    </div>
    <div class="field-unit">
      <%= label_tag :starts_at, t("admin.media_plans.starts_at", time_zone: @time_zone) %>
      <%= datetime_field_tag :starts_at, schedule_datetime_field_value(@media_plan.starts_at, @time_zone) %>
    </div>
    <div class="field-unit">
      <%= label_tag :ends_at, t("admin.media_plans.ends_at", time_zone: @time_zone) %>
      <%= datetime_field_tag :ends_at, schedule_datetime_field_value(@media_plan.ends_at, @time_zone) %>
    </div>
    <%= submit_tag t("admin.media_plans.save_window"), class: "button" %>
    <%= link_to t("administrate.actions.cancel"), admin_media_plan_path(@media_plan), class: "button button--alt" %>
  <% end %>
</section>
