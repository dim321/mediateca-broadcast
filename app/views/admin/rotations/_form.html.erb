<%= form_with model: [:admin, rotation], class: "max-w-xl bg-white border border-gray-200 rounded-lg p-6" do |f| %>
  <%= render "admin/shared/form_errors", record: rotation %>
  <div class="mb-5"><%= f.label :name, class: admin_label_class %><%= f.text_field :name, class: admin_input_class, required: true %></div>
  <div class="mb-5"><%= f.label :organization_id, class: admin_label_class %><%= f.collection_select :organization_id, Organization.order(:name), :id, :name, { include_blank: true }, class: admin_select_class %></div>
  <div class="mb-5 flex items-center gap-2"><%= f.check_box :system_managed, class: admin_checkbox_class %><%= f.label :system_managed, class: "text-sm text-gray-900" %></div>
  <div class="flex flex-wrap gap-3">
    <%= f.submit class: admin_primary_button_class %>
    <%= link_to t("admin.chrome.cancel"), admin_rotations_path, class: admin_secondary_button_class %>
  </div>
<% end %>
