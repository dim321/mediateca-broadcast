<% content_for :title, @rotation.name %>
<div class="mb-4"><h1 class="text-2xl font-semibold text-gray-900"><%= @rotation.name %></h1></div>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
    <div><dt class="text-sm font-medium text-gray-500"><%= Rotation.human_attribute_name(:name) %></dt><dd class="mt-1 text-sm text-gray-900"><%= @rotation.name %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= Organization.model_name.human %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@rotation.organization) %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= Rotation.human_attribute_name(:system_managed) %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_boolean(@rotation.system_managed) %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= t("admin.nav.rotation_items") %></dt><dd class="mt-1 text-sm text-gray-900"><%= @rotation.rotation_items.count %></dd></div>
  </dl>
</div>
<div class="mt-6 flex flex-wrap gap-3">
  <%= link_to t("admin.chrome.edit"), edit_admin_rotation_path(@rotation), class: admin_primary_button_class %>
  <%= link_to t("admin.chrome.back"), admin_rotations_path, class: admin_secondary_button_class %>
  <%= button_to t("admin.chrome.destroy"), admin_rotation_path(@rotation), method: :delete, data: { turbo_confirm: t("admin.crud.destroy_confirm") }, class: admin_danger_button_class %>
</div>
