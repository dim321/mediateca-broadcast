<% content_for :title, admin_attachment_name(@media_asset.file) %>
<div class="mb-4">
  <h1 class="text-2xl font-semibold text-gray-900"><%= admin_attachment_name(@media_asset.file) %></h1>
</div>
<% if @media_asset.video? %>
  <% if @media_asset.ready? && @media_asset.broadcast_file.attached? %>
    <div class="mb-6">
      <video class="w-full max-w-3xl" controls
             data-controller="media-asset-player"
             data-media-asset-player-url-value="<%= url_for(@media_asset.broadcast_file) %>"></video>
    </div>
  <% else %>
    <p class="mb-6 text-sm text-gray-500"><%= t("media_assets.show.video_not_ready") %></p>
  <% end %>
<% elsif @media_asset.ready? && @media_asset.file.attached? %>
  <div class="mb-6">
    <% if @media_asset.audio? %>
      <audio class="w-full max-w-3xl" controls src="<%= url_for(@media_asset.file) %>"></audio>
    <% elsif @media_asset.image? %>
      <%= image_tag url_for(@media_asset.file), class: "max-w-3xl", alt: @media_asset.file.filename.to_s %>
    <% elsif @media_asset.document? %>
      <iframe class="w-full max-w-3xl h-96" src="<%= url_for(@media_asset.file) %>" title="<%= @media_asset.file.filename %>"></iframe>
    <% else %>
      <%= link_to @media_asset.file.filename.to_s,
            rails_blob_path(@media_asset.file, disposition: :attachment),
            class: "text-blue-600 underline" %>
    <% end %>
  </div>
<% else %>
  <p class="mb-6 text-sm text-gray-500"><%= t("media_assets.show.not_ready") %></p>
<% end %>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Organization.model_name.human %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@media_asset.organization) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:file) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_attachment_name(@media_asset.file) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:preview) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_attachment_name(@media_asset.preview) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:broadcast_file) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_attachment_name(@media_asset.broadcast_file) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:content_kind) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@media_asset, :content_kind) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:content_type) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@media_asset, :content_type) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:visibility) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@media_asset, :visibility) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:processing_status) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@media_asset, :processing_status) %></dd>
    </div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= MediaAsset.human_attribute_name(:duration_seconds) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%= @media_asset.duration_seconds || t("admin.crud.none") %></dd>
    </div>
  </dl>
</div>
<div class="mt-6 max-w-xl bg-white border border-gray-200 rounded-lg p-6">
  <% if @media_asset.content_validated? %>
    <p class="text-sm text-gray-900"><%= t("media_assets.content_validation.validated") %></p>
    <p class="mt-1 text-sm text-gray-500">
      <%= t("media_assets.content_validation.validated_by",
            name: @media_asset.content_validated_by.display_name,
            time: l(@media_asset.content_validated_at, format: :long)) %>
    </p>
  <% else %>
    <p class="text-sm text-gray-500"><%= t("media_assets.content_validation.not_validated") %></p>
  <% end %>
  <% if Current.user.traffic_manager? %>
    <div class="mt-3">
      <% if @media_asset.content_validated? %>
        <%= button_to t("media_assets.content_validation.revoke"),
              revoke_content_validation_admin_media_asset_path(@media_asset),
              method: :delete,
              class: admin_secondary_button_class,
              data: { turbo_confirm: t("media_assets.content_validation.confirm_revoke") } %>
      <% elsif playable_for_validation?(@media_asset) %>
        <%= button_to t("media_assets.content_validation.mark"),
              mark_content_validation_admin_media_asset_path(@media_asset),
              class: admin_primary_button_class %>
      <% else %>
        <p class="text-sm text-gray-500"><%= t("media_assets.content_validation.not_playable") %></p>
      <% end %>
    </div>
  <% end %>
</div>
<div class="mt-6 flex flex-wrap gap-3">
  <%= link_to t("admin.chrome.edit"), edit_admin_media_asset_path(@media_asset), class: admin_primary_button_class %>
  <%= link_to t("admin.chrome.back"), admin_media_assets_path, class: admin_secondary_button_class %>
  <%= button_to t("admin.chrome.destroy"), admin_media_asset_path(@media_asset),
        method: :delete,
        data: { turbo_confirm: t("admin.crud.destroy_confirm") },
        class: admin_danger_button_class %>
</div>
