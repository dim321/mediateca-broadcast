<% content_for :title, t("admin.nav.media_assets") %>
<div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t("admin.nav.media_assets") %></h1>
</div>
<% if @media_assets.empty? && !admin_ransack_filtered? %>
  <%= render "admin/shared/empty_state", title: t("admin.crud.empty.title"), description: t("admin.crud.empty.description") %>
<% else %>
  <%= search_form_for @q, url: admin_media_assets_path, html: { method: :get } do |f| %>
    <% if params[:q].is_a?(ActionController::Parameters) %>
      <% Array(params.dig(:q, :s)).each do |sort| %><%= hidden_field_tag "q[s]", sort %><% end %>
    <% end %>
    <div class="relative overflow-x-auto shadow-md sm:rounded-lg bg-white">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3"><%= MediaAsset.human_attribute_name(:file) %></th>
            <th scope="col" class="px-6 py-3"><%= Organization.model_name.human %></th>
            <th scope="col" class="px-6 py-3"><%= sort_link @q, :content_kind %></th>
            <th scope="col" class="px-6 py-3"><%= sort_link @q, :content_type %></th>
            <th scope="col" class="px-6 py-3"><%= sort_link @q, :processing_status %></th>
            <th scope="col" class="px-6 py-3"><%= t("media_assets.index.columns.content_validation") %></th>
            <th scope="col" class="px-6 py-3"><span class="sr-only"><%= t("admin.chrome.actions") %></span></th>
          </tr>
          <tr class="normal-case font-normal bg-white">
            <th scope="col" class="px-4 py-3">
              <%= f.search_field :filename_cont,
                    class: admin_input_class,
                    placeholder: MediaAsset.human_attribute_name(:file),
                    aria: { label: MediaAsset.human_attribute_name(:file) } %>
            </th>
            <th scope="col" class="px-4 py-3">
              <%= f.collection_select :organization_id_eq, @organizations, :id, :name,
                    { include_blank: t("admin.media_assets.filters.any") },
                    class: admin_select_class,
                    aria: { label: Organization.model_name.human },
                    onchange: "this.form.requestSubmit()" %>
            </th>
            <th scope="col" class="px-4 py-3">
              <%= f.select :content_kind_eq, admin_enum_options(MediaAsset, :content_kind),
                    { include_blank: t("admin.media_assets.filters.any") },
                    class: admin_select_class,
                    aria: { label: MediaAsset.human_attribute_name(:content_kind) },
                    onchange: "this.form.requestSubmit()" %>
            </th>
            <th scope="col" class="px-4 py-3">
              <%= f.select :content_type_eq, admin_enum_options(MediaAsset, :content_type),
                    { include_blank: t("admin.media_assets.filters.any") },
                    class: admin_select_class,
                    aria: { label: MediaAsset.human_attribute_name(:content_type) },
                    onchange: "this.form.requestSubmit()" %>
            </th>
            <th scope="col" class="px-4 py-3">
              <%= f.select :processing_status_eq, admin_enum_options(MediaAsset, :processing_status),
                    { include_blank: t("admin.media_assets.filters.any") },
                    class: admin_select_class,
                    aria: { label: MediaAsset.human_attribute_name(:processing_status) },
                    onchange: "this.form.requestSubmit()" %>
            </th>
            <th scope="col" class="px-4 py-3">
              <%= f.select :content_validated_eq, media_asset_validation_filter_options,
                    { include_blank: t("admin.media_assets.filters.any") },
                    class: admin_select_class,
                    aria: { label: t("media_assets.index.columns.content_validation") },
                    onchange: "this.form.requestSubmit()" %>
            </th>
            <th scope="col" class="px-4 py-3">
              <div class="flex flex-col gap-2">
                <%= f.submit t("admin.crud.search_submit"), class: admin_primary_button_class %>
                <% if admin_ransack_filtered? %>
                  <%= link_to t("admin.crud.clear_search"), admin_media_assets_path, class: "#{admin_secondary_button_class} text-center" %>
                <% end %>
              </div>
            </th>
          </tr>
        </thead>
        <tbody>
          <% @media_assets.each do |asset| %>
            <tr class="bg-white border-b hover:bg-gray-50">
              <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
                <%= link_to admin_attachment_name(asset.file), admin_media_asset_path(asset), class: "text-blue-700 hover:underline" %>
              </th>
              <td class="px-6 py-4"><%= admin_link_to_record(asset.organization) %></td>
              <td class="px-6 py-4"><%= admin_enum_label(asset, :content_kind) %></td>
              <td class="px-6 py-4"><%= admin_enum_label(asset, :content_type) %></td>
              <td class="px-6 py-4"><%= admin_enum_label(asset, :processing_status) %></td>
              <td class="px-6 py-4"><%= media_asset_validation_label(asset) %></td>
              <td class="px-6 py-4 text-right whitespace-nowrap">
                <%= link_to t("admin.chrome.show"), admin_media_asset_path(asset), class: "font-medium text-blue-700 hover:underline me-3" %>
                <%= link_to t("admin.chrome.edit"), edit_admin_media_asset_path(asset), class: "font-medium text-blue-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @media_assets.empty? %>
        <%= render "admin/shared/empty_state",
              title: t("admin.crud.empty.search_title"),
              description: t("admin.crud.empty.search_description"),
              action_path: admin_media_assets_path,
              action_label: t("admin.crud.clear_search") %>
      <% else %>
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0 p-4">
          <span class="text-sm text-gray-500"><%= t("admin.chrome.page_entries", count: @media_assets.total_count) %></span>
          <%= paginate @media_assets, theme: "admin" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
