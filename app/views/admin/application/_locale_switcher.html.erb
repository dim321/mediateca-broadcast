<div class="main-content__locale" role="group" aria-label="<%= t("layouts.application.locale") %>">
  <%= button_to t("layouts.application.locale_ru"),
        locale_path(locale: :ru),
        method: :patch,
        class: "button #{I18n.locale == :ru ? "" : "button--alt"}" %>
  <%= button_to t("layouts.application.locale_en"),
        locale_path(locale: :en),
        method: :patch,
        class: "button #{I18n.locale == :en ? "" : "button--alt"}" %>
</div>
