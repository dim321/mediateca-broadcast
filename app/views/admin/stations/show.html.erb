<% content_for :title, @station.name %>
<div class="mb-4"><h1 class="text-2xl font-semibold text-gray-900"><%= @station.name %></h1></div>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
    <div><dt class="text-sm font-medium text-gray-500"><%= Station.human_attribute_name(:name) %></dt><dd class="mt-1 text-sm text-gray-900"><%= @station.name %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= Station.human_attribute_name(:location) %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@station.location) %></dd></div>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%= Station.human_attribute_name(:medium) %></dt>
      <dd class="mt-1">
        <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-600/20">
          <%= admin_enum_label(@station, :medium) %>
        </span>
      </dd>
    </div>
    <div><dt class="text-sm font-medium text-gray-500"><%= Station.human_attribute_name(:offline_cache_hours) %></dt><dd class="mt-1 text-sm text-gray-900"><%= @station.offline_cache_hours %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= Station.human_attribute_name(:agent_token_digest) %></dt><dd class="mt-1 text-sm text-gray-900"><%= @station.agent_token_digest.present? ? t("admin.crud.token_set") : t("admin.crud.token_blank") %></dd></div>
  </dl>
</div>

<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6">
  <div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="text-lg font-medium text-gray-900"><%= t("admin.stations.current_playlist") %></h2>
    <%= button_to t("admin.stations.regenerate_playlists"),
          regenerate_playlists_admin_station_path(@station),
          method: :post,
          data: { turbo_confirm: t("admin.stations.regen_confirm") },
          class: admin_secondary_button_class %>
  </div>

  <%= form_with url: admin_station_path(@station), method: :get, class: "mb-4 flex flex-wrap items-end gap-2" do %>
    <div>
      <label for="playlist_date" class="<%= admin_label_class %>"><%= t("admin.stations.playlist_date") %></label>
      <%= date_field_tag :date, @playlist_date.iso8601, id: "playlist_date", class: admin_input_class %>
    </div>
    <%= submit_tag t("admin.crud.search_submit"), class: admin_primary_button_class, name: nil %>
  <% end %>

  <% if @playlist %>
    <dl class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-3 text-sm text-gray-900">
      <div>
        <dt class="text-gray-500"><%= Playlist.human_attribute_name(:version) %></dt>
        <dd><%= @playlist.version %></dd>
      </div>
      <div>
        <dt class="text-gray-500"><%= Playlist.human_attribute_name(:status) %></dt>
        <dd><%= admin_enum_label(@playlist, :status) %></dd>
      </div>
      <div>
        <dt class="text-gray-500"><%= Playlist.human_attribute_name(:for_date) %></dt>
        <dd><%= @playlist.for_date.iso8601 %></dd>
      </div>
    </dl>
  <% end %>

  <% items = @playlist&.items&.sort_by(&:position) || [] %>
  <% zone = @station.location.time_zone %>
  <% if items.any? %>
    <div class="relative overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3"><%= PlaylistItem.human_attribute_name(:position) %></th>
            <th scope="col" class="px-4 py-3"><%= PlaylistItem.human_attribute_name(:starts_at) %></th>
            <th scope="col" class="px-4 py-3"><%= PlaylistItem.human_attribute_name(:duration_seconds) %></th>
            <th scope="col" class="px-4 py-3"><%= PlaylistItem.human_attribute_name(:media_asset) %></th>
            <th scope="col" class="px-4 py-3"><%= PlaylistItem.human_attribute_name(:screens) %></th>
          </tr>
        </thead>
        <tbody>
          <% items.each do |item| %>
            <% anchor = @playlist.broadcast_day_starts_at %>
            <% starts_at = anchor && (anchor + item.offset_seconds.seconds).in_time_zone(zone) %>
            <tr class="bg-white border-b">
              <td class="px-4 py-3"><%= item.position %></td>
              <td class="px-4 py-3"><%= starts_at&.iso8601 || t("admin.crud.none") %></td>
              <td class="px-4 py-3"><%= item.duration_seconds %></td>
              <td class="px-4 py-3">
                <%= item.media_asset_id %>
                <%= admin_attachment_name(item.media_asset.file) %>
              </td>
              <td class="px-4 py-3"><%= item.screens.map(&:id).sort.join(", ") %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-500"><%= t("admin.stations.closed_day") %></p>
  <% end %>
</div>

<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6" data-testid="station-screens">
  <div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <h2 class="text-lg font-medium text-gray-900"><%= t("admin.stations.screens.title") %></h2>
    <div class="flex flex-wrap gap-2">
      <% unless @station.audio? && @station.screens.exists? %>
        <%= link_to t("admin.crud.new"), new_admin_screen_path(station_id: @station.id), class: admin_primary_button_class %>
      <% end %>
      <%= button_to t("admin.stations.screens.refresh"),
            admin_station_screen_refresh_path(@station),
            method: :post,
            class: admin_secondary_button_class %>
    </div>
  </div>

  <% if @screens.any? %>
    <div class="relative overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th scope="col" class="px-4 py-3"><%= Screen.human_attribute_name(:name) %></th>
            <th scope="col" class="px-4 py-3"><%= Screen.human_attribute_name(:mac_address) %></th>
            <th scope="col" class="px-4 py-3"><%= Screen.human_attribute_name(:ip_address) %></th>
            <th scope="col" class="px-4 py-3"><%= Screen.human_attribute_name(:network_registered) %></th>
          </tr>
        </thead>
        <tbody>
          <% @screens.each do |screen| %>
            <tr class="bg-white border-b">
              <th scope="row" class="px-4 py-3 font-medium text-gray-900 whitespace-nowrap">
                <%= link_to screen.name, admin_screen_path(screen), class: "text-blue-700 hover:underline" %>
              </th>
              <td class="px-4 py-3"><%= screen.mac_address&.to_s || t("admin.crud.none") %></td>
              <td class="px-4 py-3"><%= screen.ip_address&.to_s || t("admin.crud.none") %></td>
              <td class="px-4 py-3"><%= admin_boolean(screen.network_registered) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="text-sm text-gray-500"><%= t("admin.stations.screens.empty") %></p>
  <% end %>
</div>

<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="mb-4 text-lg font-medium text-gray-900"><%= t("admin.stations.telemetry") %></h2>
  <% if @telemetry %>
    <dl class="mb-4 grid grid-cols-1 gap-2 sm:grid-cols-2 text-sm text-gray-900">
      <div>
        <dt class="text-gray-500"><%= t("admin.stations.telemetry_reported_at") %></dt>
        <dd><%= @telemetry.reported_at.utc.iso8601 %></dd>
      </div>
      <div>
        <dt class="text-gray-500"><%= t("admin.stations.telemetry_package_etag") %></dt>
        <dd><%= @telemetry.package_etag %></dd>
      </div>
      <div>
        <dt class="text-gray-500"><%= t("admin.stations.telemetry_broadcast_ok") %></dt>
        <dd><%= admin_boolean(@telemetry.broadcast_ok) %></dd>
      </div>
      <div>
        <dt class="text-gray-500"><%= t("admin.stations.telemetry_ignored") %></dt>
        <dd><%= @telemetry.ignored_screen_ids.presence&.join(", ") || t("admin.crud.none") %></dd>
      </div>
    </dl>
    <table class="w-full text-sm text-left text-gray-500">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50">
        <tr>
          <th class="px-4 py-3"><%= Screen.model_name.human %></th>
          <th class="px-4 py-3"><%= t("admin.stations.telemetry_playing") %></th>
          <th class="px-4 py-3"><%= t("admin.stations.telemetry_wakefulness") %></th>
          <th class="px-4 py-3"><%= t("admin.stations.telemetry_last_error") %></th>
        </tr>
      </thead>
      <tbody>
        <% @screen_telemetry.each do |row| %>
          <tr class="bg-white border-b">
            <td class="px-4 py-3"><%= row.screen.name %></td>
            <td class="px-4 py-3"><%= admin_boolean(row.playing) %></td>
            <td class="px-4 py-3"><%= row.wakefulness.presence || t("admin.crud.none") %></td>
            <td class="px-4 py-3"><%= row.last_error.presence || t("admin.crud.none") %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-gray-500"><%= t("admin.stations.telemetry_empty") %></p>
  <% end %>
</div>

<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="mb-4 text-lg font-medium text-gray-900"><%= t("admin.stations.agent_package_v2") %></h2>
  <details data-testid="agent-package-json" class="group">
    <summary class="<%= admin_secondary_button_class %> cursor-pointer list-none w-fit [&::-webkit-details-marker]:hidden">
      <%= t("admin.stations.show_agent_package_json") %>
    </summary>
    <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-50 p-4 text-xs text-gray-900 whitespace-pre"><%= JSON.pretty_generate(@agent_package) %></pre>
  </details>
</div>

<div class="mt-6 bg-white border border-gray-200 rounded-lg p-6">
  <h2 class="mb-4 text-lg font-medium text-gray-900"><%= t("admin.stations.agent_config_v1") %></h2>
  <pre class="overflow-x-auto rounded-lg bg-gray-50 p-4 text-xs text-gray-900 whitespace-pre"><%= JSON.pretty_generate(@agent_config) %></pre>
</div>

<div class="mt-6 flex flex-wrap gap-3">
  <%= link_to t("admin.chrome.edit"), edit_admin_station_path(@station), class: admin_primary_button_class %>
  <%= link_to t("admin.chrome.back"), admin_stations_path, class: admin_secondary_button_class %>
  <%= button_to t("admin.chrome.destroy"), admin_station_path(@station), method: :delete, data: { turbo_confirm: t("admin.crud.destroy_confirm") }, class: admin_danger_button_class %>
</div>
