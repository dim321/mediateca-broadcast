<% content_for :title, t("admin.service_themes.index.title") %>

<div class="mb-4 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
  <h1 class="text-2xl font-semibold text-gray-900"><%= t("admin.service_themes.index.title") %></h1>
  <%= link_to t("admin.service_themes.new"), new_admin_service_theme_path, class: admin_primary_button_class %>
</div>

<%= search_form_for @q, url: admin_service_themes_path, html: { method: :get, class: "mb-4" } do |f| %>
  <% if params[:q].is_a?(ActionController::Parameters) %>
    <% Array(params.dig(:q, :s)).each do |sort| %>
      <%= hidden_field_tag "q[s]", sort %>
    <% end %>
  <% end %>
  <label for="q_name_cont" class="sr-only"><%= t("admin.service_themes.search") %></label>
  <div class="relative max-w-sm">
    <div class="absolute inset-y-0 start-0 flex items-center ps-3 pointer-events-none">
      <svg class="w-5 h-5 text-gray-500" aria-hidden="true" fill="none" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
      </svg>
    </div>
    <%= f.search_field :name_cont,
          id: "q_name_cont",
          class: "bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full ps-10 p-2.5",
          placeholder: t("admin.service_themes.search") %>
  </div>
  <div class="mt-2 flex gap-2">
    <%= f.submit t("admin.service_themes.search_submit"), class: admin_primary_button_class %>
    <% if params[:q].is_a?(ActionController::Parameters) && params.dig(:q, :name_cont).present? %>
      <%= link_to t("admin.service_themes.clear_search"), admin_service_themes_path, class: admin_secondary_button_class %>
    <% end %>
  </div>
<% end %>

<% if @service_themes.empty? && params[:q].blank? %>
  <%= render "admin/shared/empty_state",
        title: t("admin.service_themes.empty.title"),
        description: t("admin.service_themes.empty.description"),
        action_path: new_admin_service_theme_path,
        action_label: t("admin.service_themes.new") %>
<% elsif @service_themes.empty? %>
  <%= render "admin/shared/empty_state",
        title: t("admin.service_themes.empty.search_title"),
        description: t("admin.service_themes.empty.search_description"),
        action_path: admin_service_themes_path,
        action_label: t("admin.service_themes.clear_search") %>
<% else %>
  <div class="relative overflow-x-auto shadow-md sm:rounded-lg bg-white">
    <table class="w-full text-sm text-left text-gray-500">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50">
        <tr>
          <th scope="col" class="px-6 py-3">
            <%= sort_link @q, :name %>
          </th>
          <th scope="col" class="px-6 py-3">
            <%= sort_link @q, :created_at %>
          </th>
          <th scope="col" class="px-6 py-3">
            <span class="sr-only"><%= t("admin.chrome.actions") %></span>
          </th>
        </tr>
      </thead>
      <tbody>
        <% @service_themes.each do |theme| %>
          <tr class="bg-white border-b hover:bg-gray-50">
            <th scope="row" class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap">
              <%= link_to theme.name, admin_service_theme_path(theme), class: "text-blue-700 hover:underline" %>
            </th>
            <td class="px-6 py-4"><%= l(theme.created_at, format: :short) %></td>
            <td class="px-6 py-4 text-right whitespace-nowrap">
              <%= link_to t("admin.chrome.show"), admin_service_theme_path(theme), class: "font-medium text-blue-700 hover:underline me-3" %>
              <%= link_to t("admin.chrome.edit"), edit_admin_service_theme_path(theme), class: "font-medium text-blue-700 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center space-y-3 md:space-y-0 p-4">
      <span class="text-sm text-gray-500"><%= t("admin.chrome.page_entries", count: @service_themes.total_count) %></span>
      <%= paginate @service_themes, theme: "admin" %>
    </div>
  </div>
<% end %>
