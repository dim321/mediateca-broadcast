<%= form_with model: [ :admin, service_theme ], class: "max-w-xl bg-white border border-gray-200 rounded-lg p-6" do |f| %>
  <% if service_theme.errors.any? %>
    <div role="alert" class="p-4 mb-4 text-sm text-red-800 rounded-lg bg-red-50">
      <ul class="list-disc ms-4">
        <% service_theme.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-5">
    <%= f.label :name, class: admin_label_class %>
    <%= f.text_field :name, class: "#{admin_input_class} #{'border-red-500' if service_theme.errors[:name].any?}", required: true %>
  </div>

  <% if service_theme.new_record? %>
    <fieldset class="mb-5">
      <legend class="<%= admin_label_class %>"><%= ServiceTheme.human_attribute_name(:medium) %></legend>
      <div class="space-y-2">
        <% admin_enum_options(ServiceTheme, :medium).each do |label, value| %>
          <div class="flex items-center">
            <%= f.radio_button :medium, value, class: "h-4 w-4 border-gray-300 text-blue-600 focus:ring-blue-500" %>
            <%= f.label :medium, label, value: value, class: "ml-2 text-sm text-gray-700" %>
          </div>
        <% end %>
      </div>
      <p class="mt-2 text-sm text-gray-500"><%= t("admin.service_themes.medium_hint") %></p>
    </fieldset>
  <% else %>
    <div class="mb-5">
      <%= f.label :medium, class: admin_label_class %>
      <p class="mt-1">
        <span class="inline-flex items-center rounded-md bg-gray-50 px-2 py-1 text-xs font-medium text-gray-700 ring-1 ring-inset ring-gray-600/20">
          <%= admin_enum_label(service_theme, :medium) %>
        </span>
      </p>
    </div>
  <% end %>

  <div class="flex flex-wrap gap-3">
    <%= f.submit class: admin_primary_button_class %>
    <%= link_to t("admin.chrome.cancel"), admin_service_themes_path, class: admin_secondary_button_class %>
  </div>
<% end %>
