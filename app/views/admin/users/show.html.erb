<% content_for :title, @user.email %>
<div class="mb-4"><h1 class="text-2xl font-semibold text-gray-900"><%= @user.email %></h1></div>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
    <div><dt class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:email) %></dt><dd class="mt-1 text-sm text-gray-900"><%= @user.email %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:organization) %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@user.organization) %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:role) %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_enum_label(@user, :role) %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:created_at) %></dt><dd class="mt-1 text-sm text-gray-900"><%= l(@user.created_at, format: :long) %></dd></div>
  </dl>
</div>
<div class="mt-6 flex flex-wrap gap-3">
  <%= link_to t("admin.chrome.edit"), edit_admin_user_path(@user), class: admin_primary_button_class %>
  <%= link_to t("admin.chrome.back"), admin_users_path, class: admin_secondary_button_class %>
  <%= button_to t("admin.chrome.destroy"), admin_user_path(@user), method: :delete, data: { turbo_confirm: t("admin.crud.destroy_confirm") }, class: admin_danger_button_class %>
</div>
