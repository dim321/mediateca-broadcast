<%= form_with model: [ :admin, portrait ], class: "max-w-5xl bg-white border border-gray-200 rounded-lg p-6" do |f| %>
  <%= render "admin/shared/form_errors", record: portrait %>

  <div class="mb-5">
    <%= f.label :name, class: admin_label_class %>
    <%= f.text_field :name, class: admin_input_class, required: true %>
  </div>

  <div class="mb-5">
    <%= f.label :block_frequency_per_hour, class: admin_label_class %>
    <%= f.number_field :block_frequency_per_hour, min: 1, max: 60, class: admin_input_class, required: true %>
  </div>

  <div class="mb-5">
    <%= f.label :max_commercial_in_row, class: admin_label_class %>
    <%= f.number_field :max_commercial_in_row, min: 1, class: admin_input_class, required: true %>
  </div>

  <div class="mb-5">
    <%= f.label :neutral_min_seconds, class: admin_label_class %>
    <%= f.select :neutral_min_seconds, [ 5, 10 ], {}, class: admin_select_class %>
  </div>

  <% if portrait.template? %>
    <div class="mb-5 flex items-center gap-2">
      <%= f.check_box :is_default, class: admin_checkbox_class %>
      <%= f.label :is_default, class: "text-sm text-gray-900" %>
    </div>
  <% else %>
    <div class="mb-5">
      <p class="<%= admin_label_class %>"><%= Screen.model_name.human %></p>
      <p class="text-sm text-gray-900"><%= admin_link_to_record(portrait.screen) %></p>
    </div>
  <% end %>

  <div class="mb-5" data-controller="portrait-blocks">
    <h2 class="mb-3 text-lg font-medium text-gray-900"><%= t("admin.broadcast_portraits.blocks") %></h2>
    <div class="space-y-4" data-portrait-blocks-target="list">
      <% portrait.blocks.sort_by { |block| block.position.to_i }.each do |block| %>
        <%= render "block_fields", block: block, rotations: rotations, service_themes: service_themes %>
      <% end %>
    </div>
    <button type="button" class="<%= admin_secondary_button_class %> mt-3" data-action="portrait-blocks#add">
      <%= t("admin.broadcast_portraits.add_block") %>
    </button>
    <template data-portrait-blocks-target="template">
      <%= render "block_fields", block: BroadcastPortraitBlock.new, rotations: rotations, service_themes: service_themes %>
    </template>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= f.submit class: admin_primary_button_class %>
    <%= link_to t("admin.chrome.cancel"), admin_broadcast_portraits_path, class: admin_secondary_button_class %>
  </div>
<% end %>
