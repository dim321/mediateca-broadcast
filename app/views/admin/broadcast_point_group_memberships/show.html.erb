<% content_for :title, "#{BroadcastPointGroupMembership.model_name.human} ##{@broadcast_point_group_membership.id}" %>
<div class="mb-4"><h1 class="text-2xl font-semibold text-gray-900"><%= BroadcastPointGroupMembership.model_name.human %> #<%= @broadcast_point_group_membership.id %></h1></div>
<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
    <div><dt class="text-sm font-medium text-gray-500"><%= BroadcastPointGroup.model_name.human %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@broadcast_point_group_membership.broadcast_point_group) %></dd></div>
    <div><dt class="text-sm font-medium text-gray-500"><%= Screen.model_name.human %></dt><dd class="mt-1 text-sm text-gray-900"><%= admin_link_to_record(@broadcast_point_group_membership.screen) %></dd></div>
  </dl>
</div>
<div class="mt-6 flex flex-wrap gap-3">
  <%= link_to t("admin.chrome.edit"), edit_admin_broadcast_point_group_membership_path(@broadcast_point_group_membership), class: admin_primary_button_class %>
  <%= link_to t("admin.chrome.back"), admin_broadcast_point_group_memberships_path, class: admin_secondary_button_class %>
  <%= button_to t("admin.chrome.destroy"), admin_broadcast_point_group_membership_path(@broadcast_point_group_membership), method: :delete, data: { turbo_confirm: t("admin.crud.destroy_confirm") }, class: admin_danger_button_class %>
</div>
