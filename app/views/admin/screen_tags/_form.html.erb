<%= form_with model: [:admin, screen_tag], class: "max-w-xl bg-white border border-gray-200 rounded-lg p-6" do |f| %>
  <%= render "admin/shared/form_errors", record: screen_tag %>
  <div class="mb-5"><%= f.label :screen_id, class: admin_label_class %><%= f.collection_select :screen_id, Screen.order(:name), :id, :name, { include_blank: true }, class: admin_select_class %></div>
  <div class="mb-5"><%= f.label :tag_id, class: admin_label_class %><%= f.collection_select :tag_id, Tag.order(:name), :id, :name, { include_blank: true }, class: admin_select_class %></div>
  <div class="flex flex-wrap gap-3">
    <%= f.submit class: admin_primary_button_class %>
    <%= link_to t("admin.chrome.cancel"), admin_screen_tags_path, class: admin_secondary_button_class %>
  </div>
<% end %>
