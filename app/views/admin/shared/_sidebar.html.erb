<aside
  id="admin-sidebar"
  data-sidebar-target="panel"
  class="fixed top-0 left-0 z-40 w-64 h-screen pt-14 transition-transform -translate-x-full bg-white border-r border-gray-200 md:translate-x-0"
  aria-label="<%= t("admin.chrome.sidebar") %>">
  <div class="h-full px-3 pb-4 overflow-y-auto bg-white">
    <% admin_nav_sections.each_with_index do |section, index| %>
      <%= tag.ul(
            class: class_names("space-y-2 font-medium", "pt-4 mt-4 border-t border-gray-200": index.positive?),
            data: { nav_group: section[:key] }
          ) do %>
        <% if section[:key] %>
          <li>
            <%= tag.details class: "group", **(admin_nav_section_active?(section) ? { open: true } : {}) do %>
              <summary class="flex items-center w-full p-2 text-xs font-semibold tracking-wide text-gray-500 uppercase rounded-lg cursor-pointer hover:bg-gray-100 list-none [&::-webkit-details-marker]:hidden">
                <span class="flex-1 ms-3 text-left"><%= t("admin.nav.groups.#{section[:key]}") %></span>
                <svg class="w-3 h-3 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 10 6">
                  <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 4 4 4-4"/>
                </svg>
              </summary>
              <ul class="py-2 space-y-2">
                <% section[:items].each do |item| %>
                  <li>
                    <%= link_to public_send(item[:path]), **admin_nav_link_options(item) do %>
                      <span class="ms-3"><%= t("admin.nav.#{item[:key]}") %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            <% end %>
          </li>
        <% else %>
          <% section[:items].each do |item| %>
            <li>
              <%= link_to public_send(item[:path]), **admin_nav_link_options(item) do %>
                <span class="ms-3"><%= t("admin.nav.#{item[:key]}") %></span>
              <% end %>
            </li>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  </div>
</aside>
