<aside
  id="admin-sidebar"
  data-sidebar-target="panel"
  class="fixed top-0 left-0 z-40 w-64 h-screen pt-14 transition-transform -translate-x-full bg-white border-r border-gray-200 md:translate-x-0"
  aria-label="<%= t("admin.chrome.sidebar") %>">
  <div class="h-full px-3 pb-4 overflow-y-auto bg-white">
    <ul class="space-y-2 font-medium">
      <% admin_nav_items.each do |item| %>
        <li>
          <%= link_to public_send(item[:path]), **admin_nav_link_options(item) do %>
            <span class="ms-3"><%= t("admin.nav.#{item[:key]}") %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>
</aside>
