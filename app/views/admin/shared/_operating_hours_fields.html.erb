<div data-controller="operating-hours" class="mb-5">
  <p class="mb-2 text-sm text-gray-500"><%= t("admin.fields.operating_hours.hint") %></p>
  <div class="relative overflow-x-auto">
    <table class="w-full text-sm text-left text-gray-500">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50">
        <tr>
          <th scope="col" class="px-4 py-2"><%= t("admin.fields.operating_hours.day") %></th>
          <th scope="col" class="px-4 py-2"><%= t("admin.fields.operating_hours.start") %></th>
          <th scope="col" class="px-4 py-2"><%= t("admin.fields.operating_hours.end") %></th>
        </tr>
      </thead>
      <tbody>
        <% Location::OperatingHours::DAY_KEYS.each do |day| %>
          <% window = Array(location.operating_hours&.dig(day)).first || {} %>
          <tr class="bg-white border-b">
            <td class="px-4 py-2 text-gray-900"><%= t("locations.edit.days.#{day}") %></td>
            <td class="px-4 py-2">
              <input
                type="time"
                name="location[operating_hours][<%= day %>][][start]"
                value="<%= window['start'] || window[:start] %>"
                class="<%= admin_input_class %>"
                data-operating-hours-target="start"
                data-day="<%= day %>"
                data-operating-hours-day="<%= day %>"
                data-operating-hours-part="start">
            </td>
            <td class="px-4 py-2">
              <input
                type="time"
                name="location[operating_hours][<%= day %>][][end]"
                value="<%= window['end'] || window[:end] %>"
                class="<%= admin_input_class %>"
                data-operating-hours-target="end"
                data-day="<%= day %>"
                data-operating-hours-day="<%= day %>"
                data-operating-hours-part="end">
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <button
    type="button"
    class="<%= admin_secondary_button_class %> mt-3"
    data-action="operating-hours#copyMonday"
    data-operating-hours-copy-mon>
    <%= t("locations.edit.copy_monday_to_all") %>
  </button>
</div>
