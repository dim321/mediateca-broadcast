<div class="flex flex-col items-center justify-center py-16 text-center">
  <h3 class="mt-4 text-lg font-semibold text-gray-900"><%= title %></h3>
  <% if local_assigns[:description].present? %>
    <p class="mt-1 text-sm text-gray-500"><%= description %></p>
  <% end %>
  <% if local_assigns[:action_path].present? %>
    <%= link_to local_assigns[:action_label], action_path, class: "mt-6 #{admin_primary_button_class}" %>
  <% end %>
</div>
