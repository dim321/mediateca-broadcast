<li>
  <% if page.current? %>
    <span aria-current="page" class="flex items-center justify-center px-3 h-8 text-blue-600 border border-gray-300 bg-blue-50"><%= page %></span>
  <% else %>
    <%= link_to page, url, rel: page.rel, class: "flex items-center justify-center px-3 h-8 leading-tight text-gray-500 bg-white border border-gray-300 hover:bg-gray-100 hover:text-gray-700" %>
  <% end %>
</li>
