<%% content_for :title, @<%= singular_table_name %>.try(:name) || @<%= singular_table_name %>.to_s %>

<div class="mb-4">
  <h1 class="text-2xl font-semibold text-gray-900"><%%= @<%= singular_table_name %>.try(:name) || @<%= singular_table_name %>.to_s %></h1>
</div>

<div class="bg-white border border-gray-200 rounded-lg p-6 max-w-xl">
  <dl class="grid grid-cols-1 gap-4">
<% form_attributes.each do |attribute| -%>
    <div>
      <dt class="text-sm font-medium text-gray-500"><%%= <%= class_name %>.human_attribute_name(:<%= attribute.name %>) %></dt>
      <dd class="mt-1 text-sm text-gray-900"><%%= @<%= singular_table_name %>.<%= attribute.name %> %></dd>
    </div>
<% end -%>
  </dl>
</div>

<div class="mt-6 flex flex-wrap gap-3">
  <%%= link_to t("admin.chrome.edit"), edit_<%= show_route_helper %>_path(@<%= singular_table_name %>), class: admin_primary_button_class %>
  <%%= link_to t("admin.chrome.back"), <%= index_route_helper %>_path, class: admin_secondary_button_class %>
  <%%= button_to t("admin.chrome.destroy"), <%= show_route_helper %>_path(@<%= singular_table_name %>),
        method: :delete,
        data: { turbo_confirm: t("admin.<%= plural_table_name %>.destroy_confirm") },
        class: admin_danger_button_class %>
</div>
