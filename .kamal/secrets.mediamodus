# Kamal с -d mediamodus читает .kamal/secrets-common и этот файл,
# а не .kamal/secrets. Те же ссылки на ENV / master.key, без сырых паролей.

# Grab the registry password from ENV
KAMAL_REGISTRY_USER=$KAMAL_REGISTRY_USER
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Improve security by using a password manager. Never check config/master.key into git!
RAILS_MASTER_KEY=$(cat config/master.key)

# Postgres accessory: must match POSTGRES_PASSWORD (same string for both).
MEDIATECA_BROADCAST_DATABASE_PASSWORD=$MEDIATECA_BROADCAST_DATABASE_PASSWORD
POSTGRES_PASSWORD=$MEDIATECA_BROADCAST_DATABASE_PASSWORD

# rustfs (S3-compatible). Export AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY before `kamal deploy`.
AWS_ACCESS_KEY_ID=$MEDIAMODUS_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=$MEDIAMODUS_AWS_SECRET_ACCESS_KEY

# wg-easy UI (accessories vpn-station и vpn-hub). Один пароль на оба.
# Задайте WIREGUARD_ADMIN_PASSWORD в .env до accessory boot.
WIREGUARD_ADMIN_PASSWORD=$WIREGUARD_ADMIN_PASSWORD
